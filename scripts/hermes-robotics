#!/usr/bin/env python3
import sys
import httpx
import json

BRIDGE_URL = "http://127.0.0.1:8081"

def get_state(robot_id):
    try:
        resp = httpx.get(f"{BRIDGE_URL}/observation/{robot_id}")
        print(json.dumps(resp.json(), indent=2))
    except Exception as e:
        print(json.dumps({"error": str(e)}))

def move(robot_id, x, y):
    try:
        payload = {"robot_id": robot_id, "tool_name": "move_to_position", "params": {"x": float(x), "y": float(y)}}
        resp = httpx.post(f"{BRIDGE_URL}/execute", json=payload)
        print(json.dumps(resp.json(), indent=2))
    except Exception as e:
        print(json.dumps({"error": str(e)}))

if __name__ == "__main__":
    if len(sys.argv) < 3:
        print("Usage: ./hermes-robotics [robot_id] [state|move] [x] [y]")
        sys.exit(1)
    
    robot_id = sys.argv[1]
    cmd = sys.argv[2]

    if cmd == "state":
        get_state(robot_id)
    elif cmd == "move":
        move(robot_id, sys.argv[3], sys.argv[4])
